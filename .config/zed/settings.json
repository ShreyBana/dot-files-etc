{
  "vim_mode": true,
  "ui_font_size": 20,
  "ui_font_family": "Hack Nerd Font Mono",
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_weight": 200,
  "buffer_font_size": 20,
  "theme": {
    "mode": "system",
    "light": "Atelier Forest Dark",
    "dark": "One Dark"
